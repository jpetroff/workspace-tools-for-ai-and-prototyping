#!/usr/bin/env bash

set -Eeuo pipefail

PROFILE="$HOME/.config/workspace/profile.env"
BACKEND="$HOME/.local/lib/workspace/desktop-backend.sh"

if [[ ! -r "$PROFILE" ]]; then
    echo "Workspace profile is missing: $PROFILE" >&2
    exit 1
fi
if [[ ! -x "$BACKEND" ]]; then
    echo "Desktop backend is missing or not executable: $BACKEND" >&2
    exit 1
fi

set -a
source "$PROFILE"
set +a
exec "$BACKEND" "$@"
