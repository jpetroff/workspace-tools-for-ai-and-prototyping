font pango:DejaVu Sans 10

# Force XWayland so arbitrary X11 tools have the stable DISPLAY=:0 endpoint.
xwayland force

set $mod Mod4
set $term foot

output * bg #20242b solid_color
default_border pixel 2
default_floating_border normal 2
gaps inner 4
gaps outer 2

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

mode passthrough {
    bindsym $mod+Pause mode default
}
bindsym $mod+Pause mode passthrough

bar {
    position bottom
    status_command /home/coder/.local/bin/workspace-status
    colors {
        background #20242b
        statusline #e5e9f0
        focused_workspace #5e81ac #5e81ac #ffffff
        inactive_workspace #3b4252 #3b4252 #d8dee9
    }
}
