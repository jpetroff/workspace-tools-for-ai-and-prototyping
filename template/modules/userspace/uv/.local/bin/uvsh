#!/usr/bin/env bash

# A virtual environment cannot be activated in its parent shell by executing a
# child process. Use the `uvinit` function installed by this feature, or source
# this file directly: `. uvsh [VENV]`.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    echo "[ERROR] uvsh must be sourced; run: . uvsh [VENV]" >&2
    exit 2
fi

venv_name="${1:-.venv}"

# Remove trailing Linux or Windows separators without damaging absolute paths.
while [[ "$venv_name" == */ || "$venv_name" == *\\ ]]; do
    venv_name="${venv_name%?}"
done

if [[ -z "$venv_name" ]]; then
    echo "[ERROR] Python venv path is empty" >&2
    return 2
fi

if [[ -n "${WINDIR:-}" && -d "$WINDIR" ]]; then
    venv_bin="Scripts/activate"
else
    venv_bin="bin/activate"
fi

activator="${venv_name}/${venv_bin}"
echo "[INFO] Activate Python venv: ${venv_name} (via ${activator})"

if [[ ! -f "$activator" ]]; then
    echo "[ERROR] Python venv not found: ${venv_name}" >&2
    return 1
fi

# shellcheck disable=SC1090
. "$activator"
