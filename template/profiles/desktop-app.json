{
  "$schema": "../profile.schema.json",
  "schema_version": 2,
  "name": "coder-ai-desktop-app",
  "description": "Tauri desktop-app workspace with a browser IDE, software-rendered Wayland and native debugging.",
  "image": "coder-ai-desktop-app:latest",
  "features": {
    "root": ["core", "desktop-common", "wayland", "wayland-software", "fonts", "tauri"],
    "userspace": ["linuxbrew", "bun", "uv", "starship"]
  },
  "display": {
    "backend": "wayland-software",
    "autostart": true,
    "screen_size": "1440x960",
    "vnc_port": 5900,
    "novnc_port": 6080
  },
  "coder_modules": ["code-server"],
  "native_debug": true,
  "shm_size_mb": 1024
}
