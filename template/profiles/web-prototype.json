{
  "$schema": "../profile.schema.json",
  "schema_version": 2,
  "name": "coder-ai-web-prototype",
  "description": "Web prototyping workspace with a browser IDE, live preview, Playwright and an interactive desktop.",
  "image": "coder-ai-web-prototype:latest",
  "features": {
    "root": ["core", "desktop-common", "x11-openbox", "fonts", "playwright"],
    "userspace": ["linuxbrew", "bun", "uv", "starship"]
  },
  "display": {
    "backend": "x11-openbox",
    "autostart": true,
    "screen_size": "1440x960",
    "vnc_port": 5900,
    "novnc_port": 6080
  },
  "preview": {
    "enabled": true,
    "port": 3000
  },
  "playwright": {
    "deps_version": "1.62.0"
  },
  "coder_modules": ["code-server"],
  "native_debug": false,
  "shm_size_mb": 1024
}
